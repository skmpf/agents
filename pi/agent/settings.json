{
  "lastChangelogVersion": "0.82.1",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.2",
  "defaultThinkingLevel": "medium",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "zai/glm-5.2",
        "thinking": "off"
      },
      "delegate": {
        "model": "zai/glm-5.2",
        "thinking": "off"
      },
      "context-builder": {
        "model": "zai/glm-5.2",
        "thinking": "low"
      },
      "researcher": {
        "model": "zai/glm-5.2",
        "thinking": "low"
      }
    }
  },
  "extensions": ["~/.pi/agent/extensions"],
  "enabledModels": [
    "zai/glm-5.2",
    "zai/glm-5-turbo",
    "zai/glm-5v-turbo",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "github-copilot/gpt-5.6-luna",
    "github-copilot/gpt-5.6-sol",
    "github-copilot/gpt-5.6-terra",
    "omlx/Qwen3-8B-4bit"
  ],
  "packages": [
    "npm:pi-rtk-optimizer",
    "npm:pi-prefer-rg",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-web-access",
    "git:github.com/amosblomqvist/pi-dictate"
  ],
  "theme": "dark"
}
